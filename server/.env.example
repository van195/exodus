PORT=5000

DATABASE_URL=postgresql://postgres.your_project:your_password@aws-0-region.pooler.supabase.com:6543/postgres

JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional delivery type: "authenticated", "private", or "upload" (default: "authenticated")
CLOUDINARY_DELIVERY_TYPE=authenticated

# Maximum upload size in bytes (default: 10485760 = 10 MB)
MAX_FILE_SIZE_BYTES=10485760
